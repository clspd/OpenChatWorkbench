{
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Cross-Origin-Embedder-Policy",
                    "value": "require-corp"
                },
                {
                    "key": "Cross-Origin-Opener-Policy",
                    "value": "same-origin"
                },
                {
                    "key": "Cross-Origin-Resource-Policy",
                    "value": "cross-origin"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "SAMEORIGIN"
                },
                {
                    "key": "Content-Security-Policy",
                    "value": "frame-ancestors 'self'; base-uri 'self'; manifest-src 'self'; script-src-attr 'none'; report-uri https://csp-report-collector.openchatworkbench.com/csp-report; report-to csp-report-collector-v1"
                },
                {
                    "key": "Reporting-Endpoints",
                    "value": "csp-report-collector-v1=\"https://csp-report-collector.openchatworkbench.com/csp-report\""
                },
                {
                    "key": "Report-To",
                    "value": "{\"group\":\"csp-report-collector-v1\",\"max_age\":60,\"endpoints\":[{\"url\":\"https://csp-report-collector.openchatworkbench.com/csp-report\"}]}"
                }
            ]
        }
    ]
}